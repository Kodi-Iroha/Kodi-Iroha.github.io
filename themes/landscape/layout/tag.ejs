

<div class="layout-tag">
    <h1 class="LT-main-title"># <span><%= page.tag %></span></h1>
    

    <div class="LT-postlist">
        <% page.posts.each(function(post) { %>
            <a href="<%- url_for(post.path) %>" class="LT-box">
                <article class="LT-box-content"> 
                    <div class="LT-box-image">
                        <% if (post.cover) { %>
                        <img src="<%= post.cover%>" alt="cover" class="LT-box-img">
                        <% }else{ %>
                        <img src="" alt="">
                        <% } %> 
                    </div>
                    <div class="LT-box-word">
                        <h2 class="LTB-title"><%= post.title %></h2>
                        <span class="LTB-date"><%= post.date.format('YYYY-MM-DD') %></span> 
                        <p class="LTB-description"><%= post.description %></p>
                    </div> 
                    <div>
                        
                    </div>
                </article>
            </a>
        <% }); %>
    </div> 
    <div class="layout-tag-blog-tools">
        <%- partial('_partial/blog_tools') %>
    </div>
</div> 
