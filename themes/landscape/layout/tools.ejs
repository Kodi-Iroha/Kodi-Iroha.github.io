<h1 class="layout-tools-h1"><%= page.title || 'Tools' %></h1>

<div class="layout-tools"> 
  <div class="layout-tools-content">
    <!-- 直接輸出頁面內容（支援 HTML 或 Markdown 轉換後的 page.content） -->
    <%- page.content %>
  </div>

  <div class="layout-tools-sidebar">
    <!-- 側邊欄或工具區塊（可以改用其他 partial） -->
    <%- partial('_partial/blog_tools') %>
  </div>

</div>
