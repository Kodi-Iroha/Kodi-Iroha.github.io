<head>
  <meta charset="utf-8">
  <%
  var title = page.title;

  if (is_archive()){
    title = __('archive_a');
    if (is_month()){
      title += ': ' + page.year + '/' + page.month;
    } else if (is_year()){
      title += ': ' + page.year;
    }
  } else if (is_category()){
    title = __('category') + ': ' + page.category;
  } else if (is_tag()){
    title = __('tag') + ': ' + page.tag;
  }
  %>
  <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <%- open_graph({twitter_id: theme.twitter, fb_admins: theme.fb_admins, fb_app_id: theme.fb_app_id}) %>
  <% if (config.feed) { %>
    <%- feed_tag() %>
  <% } else if (theme.rss) { %>
    <%- feed_tag(theme.rss) %>
  <% } %>
  <% if (theme.favicon){ %>
    <%- favicon_tag(theme.favicon) %>
  <% } %>


  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=LINE+Seed+JP&family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet"> 

  <% if (config.highlight.enable){ %>
    <%- css('https://cdn.jsdelivr.net/npm/typeface-source-code-pro@0.0.71/index.min.css') %>
  <% } %>
  
  <!-- 這是載入你的 css/style.css 的 Hexo 專屬寫法喔！ -->
  <%- css('css/iroha_style') %>
  
  <% if (theme.fancybox){ %>
    <%- css('fancybox/jquery.fancybox.min.css') %>
  <% } %>
  <%- css('https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css') %>
</head> 
<script>
// 當使用者滾動網頁時，觸發 moveProgressBar 函式
window.onscroll = function() { moveProgressBar() };

function moveProgressBar() {
  // 取得使用者目前向下滾動了多少像素 (px)
  var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
  
  // 計算整個網頁扣掉螢幕高度後，實際上「可滾動的總高度」
  var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
  
  // 換算成百分比
  var scrolled = (winScroll / height) * 100;
  
  // 將這個百分比動態套用到 CSS 的 width 寬度上
  document.getElementById("myBar").style.width = scrolled + "%";
}
</script> 
